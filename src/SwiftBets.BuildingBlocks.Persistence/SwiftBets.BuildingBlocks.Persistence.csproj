<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>SwiftBets.BuildingBlocks.Persistence</PackageId>
    <Description>Dapper connection factories, embedded SQL resources, DbUp migration runner, transactional inbox.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="dbup-sqlserver" />
    <PackageReference Include="dbup-postgresql" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Npgsql" />
    <ProjectReference Include="../SwiftBets.BuildingBlocks.Core/SwiftBets.BuildingBlocks.Core.csproj" />
    <ProjectReference Include="../SwiftBets.BuildingBlocks.Resilience/SwiftBets.BuildingBlocks.Resilience.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Sql/*.sql" />
    <EmbeddedResource Include="Migrations/*.sql" />
  </ItemGroup>
</Project>
